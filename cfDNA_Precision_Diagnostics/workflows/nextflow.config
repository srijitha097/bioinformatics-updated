params {
    samplesheet = "workflows/samplesheet.csv"
    reference = "ngs_pipeline/data/reference/single_gene/combined_reference.fa"
    outdir = "results/nextflow/smoke_test"
}

process {
    executor = 'local'
    cpus = 2
    memory = '2 GB'
    maxForks = 2
    errorStrategy = 'terminate'
}

profiles {
    local {
        docker.enabled = false
        conda.enabled = false
    }

    docker {
        docker.enabled = true
        conda.enabled = false
        process.container = 'cfdna-pipeline:1.0.0'
    }
}

manifest {
    name = 'cfDNA Precision Diagnostics'
    version = '1.0.0'
    description = 'Reproducible targeted cfDNA sequencing workflow'
}

report {
    overwrite = true
}

timeline {
    overwrite = true
}

trace {
    overwrite = true
}
